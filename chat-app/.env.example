# ============================================================
#  Chat App — Environment Variables
#  Copy this file to .env and fill in the values
#  (Never commit .env — it is listed in .gitignore)
# ============================================================

# ------------------------------------------------------------
# Socket.IO / Express Backend URL
#
# The URL of the running Express + Socket.IO server.
#
# - Local development: leave this pointing to localhost
# - Production (Vercel): set this to your hosted backend URL
#   e.g. https://exact-space-chat-application.onrender.com
#
# If this variable is not set:
#   - In dev mode  → falls back to http://localhost:5001
#   - In prod mode → falls back to https://exact-space-chat-application.onrender.com
# ------------------------------------------------------------
VITE_SOCKET_URL=http://localhost:5001

